{
    "name": "resa/rsyslog-dashboard",
    "description": "Dashboard PHP (MVC maison) de visualisation des logs Resa centralisés via rsyslog",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    }
}
