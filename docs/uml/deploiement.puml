@startuml deploiement
' Diagramme de déploiement — stack Docker (5 services)
skinparam componentStyle rectangle

node "Hôte Docker" {

  node "resa-frontend\n(nginx)" as Front {
    [SPA React (build)]
    [nginx + log http_access]
  }

  node "resa-backend\n(Laravel 8.x / PHP 8.4)" as Back {
    [API REST]
    [EventLogger]
  }

  node "rsyslog\n(ommysql)" as Rsys {
    [Réception TCP/UDP 514]
    [Extraction JSON (regex)]
  }

  database "mariadb" as DB {
    [Table events]
    [slow query log]
  }

  node "dashboard\n(PHP MVC)" as Dash {
    [Front controller]
    [PDO (lecture seule)]
  }
}

actor "Navigateur" as Browser

Browser --> Front : HTTP :80
Browser --> Dash  : HTTP :8080
Front --> Back    : proxy /api
Back  --> Rsys    : logs JSON\nTCP 514 (réseau interne)
Front --> Rsys    : http_access\nTCP 514 (réseau interne)
Rsys  --> DB      : INSERT (compte rsyslog)
Dash  --> DB      : SELECT (compte dashboard_ro)

note bottom of Rsys
  Port 514 NON publié sur l'hôte
  (cloisonnement ANSSI R15)
end note

note bottom of DB
  Volume persistant
  2 comptes : rsyslog (INSERT) / dashboard_ro (SELECT)
end note
@enduml
