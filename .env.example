# ─────────────────────────────────────────────────────────────
# Configuration du stack docker-compose (rsyslog dashboard)
# Copier ce fichier en .env :  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Base de données MariaDB (partagée rsyslog -> dashboard)
DB_NAME=rsyslog_dashboard
DB_USER=rsyslog
DB_PASSWORD=rsyslog_pwd
DB_ROOT_PASSWORD=root_pwd

# Ports exposés sur la machine hôte
FRONTEND_PORT=5173
BACKEND_PORT=8000
DASHBOARD_PORT=8080
DB_PORT=3306
