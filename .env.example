# ─────────────────────────────────────────────────────────────
# Configuration du stack docker-compose (rsyslog dashboard)
# Copier ce fichier en .env :  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Base de données MariaDB (partagée rsyslog -> dashboard)
# Compte applicatif utilisé par rsyslog : il INSÈRE les journaux.
DB_NAME=rsyslog_dashboard
DB_USER=rsyslog
DB_PASSWORD=rsyslog_pwd
DB_ROOT_PASSWORD=root_pwd

# Compte LECTURE SEULE utilisé par le dashboard (principe de moindre
# privilège : il ne peut que consulter les journaux, jamais les modifier).
DASHBOARD_DB_USER=dashboard_ro
DASHBOARD_DB_PASSWORD=dashboard_ro_pwd

# Ports exposés sur la machine hôte
FRONTEND_PORT=5173
BACKEND_PORT=8000
DASHBOARD_PORT=8080
DB_PORT=3306
