# ─────────────────────────────────────────────────────────────
# Reverse-proxy Caddy — TLS automatique (Let's Encrypt).
#
# Caddy est le point d'entrée public (ports 80/443). Il obtient et renouvelle
# tout seul le certificat du domaine, puis relaie en HTTP interne vers le
# conteneur nginx qui sert la SPA Resa et proxifie l'API Laravel.
#
# Le domaine est injecté depuis l'environnement (docker-compose -> .env).
#
# E-mail ACME : optionnel mais recommandé (notifications d'expiration). Pour
# l'activer, renseigne ACME_EMAIL dans .env puis dé-commente le bloc global :
#
#   {
#       email {$ACME_EMAIL}
#   }
# ─────────────────────────────────────────────────────────────

{$RESA_DOMAIN} {
	encode gzip
	reverse_proxy resa-frontend:80
}
